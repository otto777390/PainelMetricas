/* =============================================================================
   MOTOR DO PAINEL — fonte única de verdade dos números.
   =============================================================================

   Consumido por dois sites independentes:
     - Réplica do ML (Desktop\ML)      -> via <script src="motor-painel.js">
     - Vendra (Desktop\ML SAAS CLAUDE) -> via import (cópia gerada por sync-vendra.mjs)

   Os dois não conversam entre si e não precisam: o motor é determinístico
   (semente fixa + relógio). Rodando o mesmo código no mesmo instante, os dois
   chegam ao mesmo número sozinhos. Nenhum servidor, nenhuma API, nenhuma
   sincronização — o mesmo mecanismo que já mantém index.html e ao-vivo.html
   idênticos hoje.

   ATENÇÃO: este arquivo é a origem. Não edite a cópia dentro da Vendra —
   edite aqui e rode `node sync-vendra.mjs`.
   ========================================================================== */

(function (raiz, fabrica) {
    const api = fabrica();
    if (typeof module !== 'undefined' && module.exports) module.exports = api;
    else raiz.MotorPainel = api;
})(typeof globalThis !== 'undefined' ? globalThis : this, function () {
    'use strict';

    // ------------------------------------------------------------- parâmetros

    const CONFIG = {
        /* Semente do histórico. Mudar isto reescreve todos os números. */
        SEMENTE: 20251017,

        /* Faturamento acumulado da primeira venda até DATA_REF. */
        FATURAMENTO_TOTAL: 400283.47,

        /* Início da operação. */
        PRIMEIRA_VENDA: [2025, 9, 17],

        /* Data-âncora da normalização. Fixa de propósito: sem ela, o histórico
           inteiro encolheria a cada dia novo para o total continuar batendo. */
        DATA_REF: [2026, 7, 18],

        /* Curva logística de crescimento (formato "taco de hóquei"). */
        CRESC_PISO: 0.03,
        CRESC_A: 7,
        CRESC_B: 0.35,

        /* Ajustes pontuais. Entram antes da normalização, então não movem o total. */
        MULT_DIA_ATUAL: 3,
        MULT_DIA_ANTERIOR: 0.45,

        /* Quantos itens do catálogo giram de fato. Os primeiros vendem mais,
           então o ranking de "mais vendidos" fica estável. */
        PRODUTOS_ATIVOS: 12,

        /* Peso de vendas por hora: madrugada parada, tarde e noite fortes. */
        PESO_HORA: [1.0, 0.6, 0.4, 0.3, 0.3, 0.5, 1.0, 2.0, 3.5, 4.5, 5.5, 6.0,
                    6.0, 5.5, 6.0, 6.5, 7.0, 7.5, 8.0, 8.5, 8.0, 7.0, 5.0, 3.0]
    };

    const PESO_TOTAL = CONFIG.PESO_HORA.reduce((s, p) => s + p, 0);
    const DIA_MS = 86400000;

    // ---------------------------------------------------------------- básicos

    /* PRNG determinístico. É o mesmo algoritmo do createRng da Vendra
       (src/lib/rng.ts), de propósito. */
    function mulberry32(a) {
        return function () {
            a |= 0; a = a + 0x6D2B79F5 | 0;
            let t = Math.imul(a ^ a >>> 15, 1 | a);
            t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t;
            return ((t ^ t >>> 14) >>> 0) / 4294967296;
        };
    }

    function semHora(d) {
        return new Date(d.getFullYear(), d.getMonth(), d.getDate());
    }

    /* Percentual de tendência derivado do próprio total: o mesmo período
       sempre exibe o mesmo %, sem sorteio a cada render. */
    function pctFixo(base, min, span) {
        return min + (Math.abs(Math.round(base)) % span);
    }

    /* Fração do dia já decorrida. Resolução de minuto de propósito: assim
       páginas que atualizam em ritmos diferentes (1s e 5s) mostram o mesmo
       número de visitas dentro do mesmo minuto. */
    function fracaoDoDia(d) {
        let acc = 0;
        for (let h = 0; h < d.getHours(); h++) acc += CONFIG.PESO_HORA[h];
        acc += CONFIG.PESO_HORA[d.getHours()] * d.getMinutes() / 60;
        return Math.min(1, acc / PESO_TOTAL);
    }

    // ------------------------------------------------------- vendas de um dia

    // ---------------------------------------------------- pedidos (catálogo)

    const STATUS_LABEL = {
        PENDING_PAYMENT: 'Aguardando pagamento',
        PAID: 'Pago',
        PROCESSING: 'Processando',
        SHIPPED: 'Enviado',
        DELIVERED: 'Entregue',
        CANCELLED: 'Cancelado'
    };

    /* Preço de venda a partir do custo, no formato ",90" que o marketplace usa.
       Determinístico pelo produto: o mesmo item custa o mesmo nos dois sites. */
    function precoDeVenda(produto) {
        if (produto.preco) return produto.preco;
        const r = mulberry32(hashTexto(produto.sku || produto.id || produto.nome));
        const bruto = (produto.custo || 15) * (1.9 + r() * 0.9);
        return Math.floor(bruto) + 0.9;
    }

    function hashTexto(txt) {
        let h = 2166136261;
        const s = String(txt);
        for (let i = 0; i < s.length; i++) {
            h ^= s.charCodeAt(i);
            h = Math.imul(h, 16777619);
        }
        return h >>> 0;
    }

    /* Status conforme a idade do pedido: o de hoje ainda está para pagar ou
       pago, o de duas semanas atrás já foi entregue. */
    function statusPorIdade(diasAtras, sorteio) {
        if (sorteio < 0.03) return 'CANCELLED';
        if (diasAtras === 0) {
            if (sorteio < 0.11) return 'PENDING_PAYMENT';
            if (sorteio < 0.72) return 'PAID';
            return 'PROCESSING';
        }
        if (diasAtras <= 2) return sorteio < 0.45 ? 'PROCESSING' : 'SHIPPED';
        if (diasAtras <= 8) return sorteio < 0.55 ? 'SHIPPED' : 'DELIVERED';
        return 'DELIVERED';
    }

    /* Monta os pedidos do dia usando produtos e preços reais do catálogo.
       O alvo é o faturamento do dia: a quantidade de pedidos é consequência
       dos preços, e não o contrário — é isso que deixa o ticket médio realista
       em vez de dividir um valor grande por poucas vendas. */
    function gerarPedidosDoDia(reg, catalogo, diasAtras) {
        reg.pedidos = [];
        reg.vendas = [];
        if (!catalogo || !catalogo.length || reg.fatCheio <= 0) return;

        const d = reg.dataObj;
        const r = mulberry32(d.getFullYear() * 10000 + (d.getMonth() + 1) * 100 + d.getDate());

        /* Só uma fatia do catálogo gira num dia — senão "mais vendidos" viraria
           uma lista aleatória diferente a cada dia. */
        const ativos = catalogo.slice(0, Math.min(CONFIG.PRODUTOS_ATIVOS, catalogo.length));
        const pesos = ativos.map((_, i) => 1 / Math.pow(i + 1, 0.65));
        const pesoTotal = pesos.reduce((a, b) => a + b, 0);

        const alvo = reg.fatCheio;
        let total = 0, guarda = 0;

        while (total < alvo && guarda++ < 600) {
            /* Sorteia o produto pelo peso (os primeiros vendem mais). */
            let corte = r() * pesoTotal, idx = 0, acc = 0;
            for (let i = 0; i < ativos.length; i++) {
                acc += pesos[i];
                if (corte <= acc) { idx = i; break; }
            }
            const p = ativos[idx];
            const preco = precoDeVenda(p);
            const quantidade = r() < 0.72 ? 1 : (r() < 0.8 ? 2 : 3);
            const valor = preco * quantidade;

            /* Último pedido: só entra se não estourar demais o alvo. */
            if (total + valor > alvo && (total + valor - alvo) > valor * 0.5) break;

            const alvoHora = r() * PESO_TOTAL;
            let accH = 0, hora = 23;
            for (let h = 0; h < 24; h++) {
                if (alvoHora <= accH + CONFIG.PESO_HORA[h]) { hora = h; break; }
                accH += CONFIG.PESO_HORA[h];
            }
            const segundo = hora * 3600 + Math.floor(r() * 3600);
            const status = statusPorIdade(diasAtras, r());

            reg.pedidos.push({
                numero: '#ML' + String(100000 + Math.floor(r() * 899999)),
                produtoId: p.id,
                titulo: p.nome,
                sku: p.sku,
                imagem: p.imagem || '',
                estoque: p.estoque || 0,
                quantidade: quantidade,
                /* Mesmo número com os dois nomes: "quantidade" é como o pedido
                   fala, "unidades" é como o painel soma. Sem o apelido, a soma
                   de unidades do dia vira NaN. */
                unidades: quantidade,
                precoUnit: preco,
                valor: valor,
                segundo: segundo,
                status: status,
                statusLabel: STATUS_LABEL[status]
            });
            total += valor;
        }

        reg.pedidos.sort((a, b) => a.segundo - b.segundo);
        /* `vendas` é a visão que o painel do ML consome; um pedido é uma venda. */
        reg.vendas = reg.pedidos;

        /* O dia passa a valer o que os pedidos realmente somam, com preços reais. */
        /* Cancelado nao conta como faturamento — mesma regra dos dois lados. */
        reg.fatCheio = reg.pedidos.reduce((soma, p) => p.status === 'CANCELLED' ? soma : soma + p.valor, 0);
        reg.venCheio = reg.pedidos.length;
        reg.uniCheio = reg.pedidos.reduce((s, p) => s + p.quantidade, 0);
        reg.canCheio = reg.pedidos.filter(p => p.status === 'CANCELLED').length;

        /* Visitas recalculadas para a conversão cair numa faixa crível (3,5%–6%). */
        const taxa = 0.035 + r() * 0.025;
        reg.visCheio = Math.max(reg.venCheio, Math.round(reg.venCheio / taxa));

        reg.faturamento = reg.fatCheio; reg.unidades = reg.uniCheio;
        reg.visitas = reg.visCheio; reg.qtdVendas = reg.venCheio; reg.canceladas = reg.canCheio;
    }

    /* Quebra o fechamento do dia em vendas individuais, cada uma com horário,
       unidades e valor. Usado quando não há catálogo (modo antigo). */
    function gerarVendasDoDia(reg) {
        reg.vendas = [];
        const n = reg.venCheio;
        if (n <= 0) return;

        /* Semente derivada da data: as vendas de um dia são sempre as mesmas,
           em qualquer um dos dois sites. */
        const d = reg.dataObj;
        const r = mulberry32(d.getFullYear() * 10000 + (d.getMonth() + 1) * 100 + d.getDate());

        const unidades = new Array(n).fill(1);
        let sobra = Math.max(0, reg.uniCheio - n);
        while (sobra > 0) { unidades[Math.floor(r() * n)]++; sobra--; }

        let bruto = 0;
        for (let i = 0; i < n; i++) {
            const alvo = r() * PESO_TOTAL;
            let acc = 0, hora = 23;
            for (let h = 0; h < 24; h++) {
                if (alvo <= acc + CONFIG.PESO_HORA[h]) { hora = h; break; }
                acc += CONFIG.PESO_HORA[h];
            }
            const valor = (r() * 90 + 45) * unidades[i];
            bruto += valor;
            reg.vendas.push({
                segundo: hora * 3600 + Math.floor(r() * 3600),
                unidades: unidades[i],
                valor: valor
            });
        }

        reg.vendas.sort((a, b) => a.segundo - b.segundo);
        const ajuste = bruto > 0 ? reg.fatCheio / bruto : 1;
        reg.vendas.forEach(v => { v.valor *= ajuste; });
    }

    /* Vendas de cada hora (não acumulado) — é o que dá o formato de onda.
       Média ponderada 1-2-1: sem isso, horas vizinhas caem no mesmo valor
       quando só uma delas teve venda. "ateSegundo" corta no horário atual. */
    function vendasPorHora(reg, ateSegundo) {
        const limite = (typeof ateSegundo === 'number') ? ateSegundo : 86399;
        const ultimaHora = Math.min(23, Math.floor(limite / 3600));

        const bruto = new Array(24).fill(0);
        (reg && reg.vendas ? reg.vendas : []).forEach(v => {
            if (v.segundo <= limite) bruto[Math.floor(v.segundo / 3600)] += v.valor;
        });

        const saida = [];
        for (let h = 0; h <= 23; h++) {
            if (h > ultimaHora) { saida.push(null); continue; }
            let soma = 0, peso = 0;
            [[h - 1, 1], [h, 2], [h + 1, 1]].forEach(function (par) {
                const k = par[0], p = par[1];
                if (k >= 0 && k <= ultimaHora) { soma += bruto[k] * p; peso += p; }
            });
            saida.push(peso > 0 ? soma / peso : 0);
        }
        return saida;
    }

    /* Total acumulado ao fim de cada hora. */
    function acumuladoPorHora(reg) {
        const saida = [];
        const vendas = (reg && reg.vendas) ? reg.vendas : [];
        let soma = 0, i = 0;
        for (let h = 0; h <= 23; h++) {
            const limite = (h + 1) * 3600;
            while (i < vendas.length && vendas[i].segundo < limite) { soma += vendas[i].valor; i++; }
            saida.push(soma);
        }
        return saida;
    }

    // ------------------------------------------------------------- histórico

    /* Monta a série completa até `ate` (padrão: hoje). Chamar duas vezes com a
       mesma data devolve exatamente os mesmos números. */
    function gerarHistorico(opcoes) {
        const opts = (opcoes instanceof Date || !opcoes) ? { ate: opcoes } : opcoes;
        const catalogo = opts.catalogo || null;
        const ate = opts.ate;
        const hoje = ate ? new Date(ate) : new Date();
        const hojeSemHora = semHora(hoje);
        const ontemSemHora = hojeSemHora.getTime() - DIA_MS;

        const primeira = new Date(CONFIG.PRIMEIRA_VENDA[0], CONFIG.PRIMEIRA_VENDA[1], CONFIG.PRIMEIRA_VENDA[2]);
        const dataRef = new Date(CONFIG.DATA_REF[0], CONFIG.DATA_REF[1], CONFIG.DATA_REF[2]);
        const totalDias = Math.round((semHora(dataRef) - semHora(primeira)) / DIA_MS) + 1;

        const logi = t => 1 / (1 + Math.exp(-CONFIG.CRESC_A * (t - CONFIG.CRESC_B)));
        const LOGI0 = logi(0), LOGI1 = logi(1);

        const rnd = mulberry32(CONFIG.SEMENTE);
        const dias = [];
        const cursor = new Date(primeira);
        let indice = 0;

        while (semHora(cursor) <= hojeSemHora) {
            let t = totalDias > 1 ? Math.min(1, indice / (totalDias - 1)) : 1;
            let crescimento = CONFIG.CRESC_PISO + (1 - CONFIG.CRESC_PISO) * ((logi(t) - LOGI0) / (LOGI1 - LOGI0));

            const diaAtual = semHora(cursor).getTime();
            if (diaAtual === hojeSemHora.getTime()) crescimento *= CONFIG.MULT_DIA_ATUAL;
            else if (diaAtual === ontemSemHora) crescimento *= CONFIG.MULT_DIA_ANTERIOR;

            const quality = rnd() * 1.1 + 0.5;
            const visitas = Math.floor((rnd() * 600 + 400) * quality * crescimento);
            const convRate = (rnd() * 3 + 1.5) / 100;
            const qtdVendas = Math.floor(visitas * convRate);
            const itensPorVenda = rnd() * 1.5 + 1;
            const unidades = Math.floor(qtdVendas * itensPorVenda);
            const precoMedio = rnd() * 80 + 70;
            const canceladas = Math.floor(qtdVendas * (rnd() * 0.05));

            dias.push({
                dataObj: new Date(cursor),
                dataStr: cursor.getDate() + ' ' + MESES[cursor.getMonth()] + '.',
                faturamento: unidades * precoMedio,
                unidades: unidades,
                visitas: visitas,
                qtdVendas: qtdVendas,
                canceladas: canceladas
            });

            cursor.setDate(cursor.getDate() + 1);
            indice++;
        }

        /* Normaliza para a primeira venda até DATA_REF somar FATURAMENTO_TOTAL.
           Visitas, vendas e unidades escalam junto, senão o preço médio e a
           conversão sairiam irreais. */
        const somaBruta = dias
            .filter(d => semHora(d.dataObj) <= semHora(dataRef))
            .reduce((s, d) => s + d.faturamento, 0);
        const escala = somaBruta > 0 ? CONFIG.FATURAMENTO_TOTAL / somaBruta : 1;

        dias.forEach(d => {
            d.faturamento *= escala;
            d.unidades = Math.floor(d.unidades * escala);
            d.visitas = Math.floor(d.visitas * escala);
            d.qtdVendas = Math.floor(d.qtdVendas * escala);
            d.canceladas = Math.floor(d.canceladas * escala);
            /* Fechamento do dia: o valor que ele terá à meia-noite. */
            d.fatCheio = d.faturamento; d.uniCheio = d.unidades;
            d.visCheio = d.visitas; d.venCheio = d.qtdVendas; d.canCheio = d.canceladas;
        });

        /* Com catálogo, todo dia vira uma lista de pedidos com produto, preço e
           status reais — é o que os dois dashboards consomem. Sem catálogo, só
           os dois últimos dias ganham vendas sintéticas (modo antigo). */
        if (catalogo && catalogo.length) {
            const ultimo = dias.length - 1;
            dias.forEach((d, i) => gerarPedidosDoDia(d, catalogo, ultimo - i));
        } else {
            gerarVendasDoDia(dias[dias.length - 1]);
            if (dias.length > 1) gerarVendasDoDia(dias[dias.length - 2]);
        }

        const hojeReg = dias[dias.length - 1];
        const ontemReg = dias[dias.length - 2] || null;

        return {
            dias: dias, hoje: hojeReg, ontem: ontemReg,
            dataRef: dataRef, primeiraVenda: primeira,
            pedidos: catalogo ? dias.reduce((acc, d) => acc.concat((d.pedidos || []).map(p => Object.assign({ dia: d.dataObj }, p))), []) : []
        };
    }

    /* Aplica o horário sobre o dia corrente: zerado à meia-noite, somando
       conforme as vendas caem. */
    function aplicarProgresso(reg, agora) {
        const segundoAtual = agora.getHours() * 3600 + agora.getMinutes() * 60 + agora.getSeconds();
        let fat = 0, uni = 0, ven = 0;
        const vendas = reg.vendas || [];
        for (let i = 0; i < vendas.length; i++) {
            if (vendas[i].segundo > segundoAtual) break;
            ven++;
            if (vendas[i].status === 'CANCELLED') continue;
            fat += vendas[i].valor; uni += vendas[i].unidades;
        }
        reg.faturamento = fat;
        reg.unidades = uni;
        reg.qtdVendas = ven;
        reg.visitas = Math.floor(reg.visCheio * fracaoDoDia(agora));
        reg.canceladas = reg.venCheio > 0 ? Math.floor(reg.canCheio * ven / reg.venCheio) : 0;
        return reg;
    }

    /* Soma um intervalo fechado de dias. É o que os dois dashboards usam para
       "últimos 7/15/30 dias" — mesma conta dos dois lados. */
    function totalizar(dias, inicio, fim) {
        const de = semHora(inicio).getTime(), ate = semHora(fim).getTime();
        const t = { faturamento: 0, unidades: 0, visitas: 0, qtdVendas: 0, canceladas: 0, dias: [] };
        dias.forEach(d => {
            const k = semHora(d.dataObj).getTime();
            if (k < de || k > ate) return;
            t.faturamento += d.faturamento; t.unidades += d.unidades; t.visitas += d.visitas;
            t.qtdVendas += d.qtdVendas; t.canceladas += d.canceladas; t.dias.push(d);
        });
        t.precoMedioUnidade = t.unidades > 0 ? t.faturamento / t.unidades : 0;
        t.precoMedioVenda = t.qtdVendas > 0 ? t.faturamento / t.qtdVendas : 0;
        t.conversao = t.visitas > 0 ? (t.qtdVendas / t.visitas) * 100 : 0;
        return t;
    }

    const MESES = ['jan', 'fev', 'mar', 'abr', 'mai', 'jun', 'jul', 'ago', 'set', 'out', 'nov', 'dez'];
    const MESES_LONGOS = ['Janeiro', 'Fevereiro', 'Março', 'Abril', 'Maio', 'Junho',
                          'Julho', 'Agosto', 'Setembro', 'Outubro', 'Novembro', 'Dezembro'];

    return {
        CONFIG: CONFIG,
        PESO_HORA: CONFIG.PESO_HORA,
        PESO_TOTAL: PESO_TOTAL,
        MESES: MESES,
        MESES_LONGOS: MESES_LONGOS,
        mulberry32: mulberry32,
        semHora: semHora,
        pctFixo: pctFixo,
        fracaoDoDia: fracaoDoDia,
        gerarHistorico: gerarHistorico,
        gerarVendasDoDia: gerarVendasDoDia,
        gerarPedidosDoDia: gerarPedidosDoDia,
        precoDeVenda: precoDeVenda,
        STATUS_LABEL: STATUS_LABEL,
        aplicarProgresso: aplicarProgresso,
        vendasPorHora: vendasPorHora,
        acumuladoPorHora: acumuladoPorHora,
        totalizar: totalizar
    };
});
